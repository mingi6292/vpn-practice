<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 터널 서버와 TCP 소켓으로 연결하려면 필요하다. 없으면 소켓 연결이 EPERM으로 실패한다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17(API 37)부터 사설 대역(10.0.2.2, 10.0.0.1)으로 통신하려면 런타임 권한이 필요하다. 없으면 터널 서버로의 TCP 연결이 EPERM으로 실패한다. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11부터 패키지 가시성 제한이 있어서, 여기 없으면 Chrome이 설치돼 있어도 NameNotFoundException이 난다. -->
    <queries>
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VpnPractice">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VpnPractice"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- systemExempted는 공식 문서에서 VPN 앱을 허용 대상으로 명시한다. lint는 exact alarm 권한만 요구해서 오탐으로 억제한다. -->
        <!-- BIND_VPN_SERVICE 권한으로 시스템(VPN 프레임워크)만 이 서비스에 바인딩할 수 있다 -->
        <service
            tools:ignore="ForegroundServicePermission"
            android:name=".vpn.PracticeVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>